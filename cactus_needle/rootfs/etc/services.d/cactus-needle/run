#!/usr/bin/with-contenv bashio
set -e

port="$(bashio::config 'port')"
generation="$(bashio::config 'generation')"
debug="$(bashio::config 'debug_logging')"
telemetry="$(bashio::config 'telemetry')"
weights="$(bashio::config 'weights')"

if bashio::var.true "${telemetry}"; then
  export CACTUS_TELEMETRY=1
else
  export CACTUS_TELEMETRY=0
fi

args=(--host 0.0.0.0 --port "${port}" --generation "${generation}")
if [[ -n "${weights}" ]]; then
  args+=(--weights "${weights}")
fi
if bashio::var.true "${debug}"; then
  args+=(--debug)
fi

bashio::log.info "Starting Cactus Needle on port ${port}"
python3 /opt/cactus-needle/server.py "${args[@]}" &
server_pid=$!
trap 'kill "${server_pid}" 2>/dev/null || true' TERM INT

for _ in $(seq 1 300); do
  if wget -q -T 2 -O /dev/null "http://127.0.0.1:${port}/health"; then
    discovery=$(bashio::var.json host "$(hostname)" port "^${port}")
    if bashio::discovery "cactus_needle" "${discovery}" >/dev/null; then
      bashio::log.info "Sent discovery information to Home Assistant"
    else
      bashio::log.warning "Could not send discovery information"
    fi
    break
  fi
  if ! kill -0 "${server_pid}" 2>/dev/null; then
    wait "${server_pid}"
    exit $?
  fi
  sleep 1
done

wait "${server_pid}"

